<pad name="2" x="-1" y="0" drill="0.7"/>
<wire x1="-0.5" y1="-1.7" x2="-2.95" y2="-1.7" width="0.127" layer="21"/>
<wire x1="-2.95" y1="-1.7" x2="-2.95" y2="2.8" width="0.127" layer="21"/>
<wire x1="-2.95" y1="2.8" x2="2.95" y2="2.8" width="0.127" layer="21"/>
<wire x1="2.95" y1="2.8" x2="2.95" y2="-1.7" width="0.127" layer="21"/>
<wire x1="2.95" y1="-1.7" x2="0.5" y2="-1.7" width="0.127" layer="21"/>
<text x="0" y="4" size="0.6" layer="25" font="vector" ratio="15" align="center">&gt;NAME</text>
<text x="0" y="2" size="0.6" layer="27" font="vector" ratio="15" align="center">&gt;VALUE</text>
<rectangle x1="-3.25" y1="-2" x2="3.25" y2="3" layer="39"/>
</package>
</packages>
<symbols>
