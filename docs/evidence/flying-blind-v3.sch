<wire x1="0.254" y1="0" x2="-1.524" y2="0" width="0.4064" layer="94"/>
<text x="1.27" y="0" size="1.524" layer="95" align="center-left">&gt;NAME</text>
<pin name="1" x="-2.54" y="0" visible="off" length="short" direction="pas" swaplevel="1"/>
</symbol>
</symbols>
<atts>
<att name="MF" constant="yes"/>
<att name="MPN" constant="yes"/>
</atts>
<devicesets>
<deviceset name="B2B-PH-K-S" prefix="J">
<description>JST-PH 2-way vertical TH</description>
<gates>
<gate name="-1" symbol="PM-N" x="0" y="2.54" addlevel="always"/>
<gate name="-2" symbol="PM-N" x="0" y="-2.54" addlevel="always"/>
</gates>
